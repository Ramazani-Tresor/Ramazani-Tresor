APP_NAME="UNILU-GRH"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://grh.unilu.local
APP_TIMEZONE=Africa/Lubumbashi
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=unilu_grh
DB_USERNAME=unilu_grh
DB_PASSWORD=

# Sessions : déconnexion automatique après 30 minutes d'inactivité, cookies chiffrés et sécurisés (HTTPS)
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Courriel (notifications). En local sans serveur SMTP, laisser MAIL_MAILER=log.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS="grh@unilu.local"
MAIL_FROM_NAME="UNILU-GRH"
GRH_MAIL_NOTIFICATIONS=true

GRH_MATRICULE_PREFIX=UNILU
GRH_ALERT_DAYS_MANDATE=90
GRH_ALERT_DAYS_SITUATION=7

# Sauvegardes chiffrées : php artisan grh:backup-key (copier la clé HORS du serveur)
BACKUP_ENCRYPTION_KEY=
BACKUP_PATH=
BACKUP_SECONDARY_PATH=
BACKUP_KEEP_DAYS=30
BACKUP_MYSQLDUMP=mysqldump
BACKUP_MYSQL=mysql

TRUSTED_PROXIES=
INITIAL_ADMIN_PASSWORD=
GRH_DEMO=false
